{
  "name": "perlyny-ukrainy",
  "version": "1.0.0",
  "description": "Інформаційний портал «Перлини України» — найвідоміші туристичні місця України",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "build:pages": "vite build --mode pages && node scripts/export-static-api.mjs",
    "start": "node server/index.js",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "dependencies": {
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "bootstrap": "^5.3.8",
    "express": "^5.3.0",
    "jquery": "^3.7.1",
    "jquery-ui": "^1.14.2",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "sass": "^1.106.1",
    "vite": "^8.3.5"
  }
}
